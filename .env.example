# Copy to .env.local for local dev, or paste these into your Vercel project's
# Environment Variables screen. NEVER commit a filled-in copy of this file.
#
# Both are OPTIONAL. Leave them unset and the app runs in bring-your-own-key
# mode: each visitor enters their own credentials on the Setup tab, and those
# stay in that visitor's browser.
#
# Get a free key: https://developer.usajobs.gov/apirequest/

USAJOBS_API_KEY=
USAJOBS_EMAIL=
