# Copy to .env.local for local dev, or paste these into your Vercel project's
# Environment Variables screen. NEVER commit a filled-in copy of this file.
#
# Every variable is OPTIONAL.

# --- USAJOBS ---------------------------------------------------------------
# Leave both unset and each visitor enters their own key on the Setup tab.
# Get a free key: https://developer.usajobs.gov/apirequest/
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# --- Access lock -----------------------------------------------------------
# Set this and the site refuses every request that does not carry the same
# value. Visitors paste it on the Setup tab. Required for AI review.
# Use a long random value, like a password manager would generate.
APP_TOKEN=

# --- AI review (off unless AI_API_KEY is set) ------------------------------
# AI_PROVIDER: anthropic (default, recommended) or openai-compatible
# AI_MODEL:    optional for anthropic (defaults to claude-opus-5-5);
#              required for openai-compatible
# AI_BASE_URL: required for openai-compatible, for example
#              https://api.openai.com/v1
#              https://generativelanguage.googleapis.com/v1beta/openai
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
